# ============================================
# CONFIGURACIÓN DE DOCKER COMPOSE - GESTGYM
# ============================================
# Copia este archivo como .env y configura tus valores

# ----------------
# BASE DE DATOS
# ----------------
DB_ROOT_PASSWORD=rootpassword
DB_USER=gymuser
DB_PASSWORD=gympassword
DB_NAME=gym_db
DB_PORT=3306

# ----------------
# SERVIDOR BACKEND
# ----------------
PORT=5000
BACKEND_PORT=5000
GIN_MODE=release
APP_ENV=production
ENV=production

# ----------------
# JWT SECRET
# ----------------
# IMPORTANTE: Cambia este valor en producción
JWT_SECRET=mi_clave_secreta_muy_segura_cambiar_en_produccion

# ----------------
# URLs DE LA APLICACIÓN
# ----------------
FRONTEND_URL=http://localhost:3000
BASE_URL=http://localhost:5000
REACT_APP_API_URL=http://localhost:5000

# ----------------
# EMAIL SMTP (GMAIL)
# ----------------
# Para Gmail, usa una "Contraseña de aplicación" (App Password)
# Genera una en: https://myaccount.google.com/apppasswords
EMAIL_FROM=noreply@gestgym.com
EMAIL_PASSWORD=tu_password_de_email_aqui
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
CONTACT_EMAIL=admin@gestgym.com
CONTACT_RECIPIENT=admin@gestgym.com
MOCK_EMAIL=false

# ----------------
# PAYPAL (opcional)
# ----------------
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=sandbox

# ----------------
# COINBASE COMMERCE (opcional)
# ----------------
COINBASE_COMMERCE_API_KEY=
COINBASE_WEBHOOK_SECRET=

# ----------------
# STRIPE (opcional)
# ----------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ----------------
# TIMEZONE
# ----------------
TIMEZONE=America/Mexico_City

# ----------------
# PUERTOS
# ----------------
FRONTEND_PORT=3000

# ===========================================
# NOTAS IMPORTANTES:
# ===========================================
# 1. Copia este archivo como .env en la raíz del proyecto
# 2. Modifica los valores según tu entorno
# 3. NUNCA subas el archivo .env a Git
# 4. El archivo .env debe estar en la raíz del proyecto (junto a docker-compose.yml)
# 5. El archivo backend/.env se usa solo cuando corres el backend fuera de Docker
